{
  "name": "tech-quiz",
  "version": "1.0.0",
  "description": "Full-Stack Tech Quiz Assessment Platform",
  "main": "server/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "server": "nodemon server/server.js",
    "client": "npm start --prefix client",
    "build": "npm run build --prefix client",
    "vercel-build": "npm install --prefix client && npm run build --prefix client",
    "dev": "concurrently \"npm run client\" \"npm run server\""
  },
  "author": "TechQuiz Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.1",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.6.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^2.0.20"
  }
}
